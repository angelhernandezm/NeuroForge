<Project>

  <!-- Shared metadata for every project in the repository.
       Package-specific metadata (PackageId, Version, Authors, Description) lives in
       src/dotnet/NeuroForge.Factory/NeuroForge.Factory.csproj. -->
  <PropertyGroup>
    <Company>Angel Hernandez</Company>
    <Copyright>Copyright (c) Angel Hernandez</Copyright>
    <Product>NeuroForge</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Repository / license information used by generated packages. -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/angelhernandezm/NeuroForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/angelhernandezm/NeuroForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Nothing is packable unless a project opts in explicitly. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Deterministic, source-linked builds (SourceLink ships with the .NET SDK). -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
