<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NeuroForge.Factory</RootNamespace>
    <AssemblyName>NeuroForge.Factory</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata. This is the only packable project in the repository. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NeuroForge</PackageId>
    <Title>NeuroForge — Neural Network Engine for .NET</Title>
    <Description>Build, train and export neural networks (MLP, CNN, RNN/LSTM, Autoencoder, GAN, Transformer) from strongly-typed C# configuration — no Python code required. NeuroForge bootstraps and manages a Python/TensorFlow runtime for you, trains on image folders, CSV/Excel, NumPy arrays or built-in datasets (CIFAR-10, MNIST, IMDB), and automatically exports every model to ONNX so it runs anywhere: ML.NET, ONNX Runtime, Azure ML, edge or mobile — with no TensorFlow dependency at inference time. Windows only for now.</Description>
    <PackageTags>neural-network;machine-learning;deep-learning;ai;ann;cnn;rnn;lstm;gan;transformer;autoencoder;tensorflow;keras;onnx;ml;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/angelhernandezm/NeuroForge/releases</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Factory\autoencoder_builder.py" />
    <None Remove="Resources\Factory\base_builder.py" />
    <None Remove="Resources\Factory\Builders\__init__.py" />
    <None Remove="Resources\Factory\dataset_loader.py" />
    <None Remove="Resources\Factory\factory_config.json" />
    <None Remove="Resources\Factory\gan_builder.py" />
    <None Remove="Resources\Factory\mlp_builder.py" />
    <None Remove="Resources\Factory\model_factory.py" />
    <None Remove="Resources\Factory\rnn_builder.py" />
    <None Remove="Resources\Factory\transformer_builder.py" />
    <None Remove="Resources\Factory\__init__.py" />
    <None Remove="Resources\package_list.json" />
    <None Remove="Resources\python_runtime.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Factory\Builders\autoencoder_builder.py" />
    <EmbeddedResource Include="Resources\Factory\Builders\base_builder.py" />
    <EmbeddedResource Include="Resources\Factory\Builders\cnn_builder.py" />
    <EmbeddedResource Include="Resources\Factory\Builders\__init__.py" />
    <EmbeddedResource Include="Resources\Factory\convert_to_onnx.py" />
    <EmbeddedResource Include="Resources\Factory\dataset_loader.py" />
    <EmbeddedResource Include="Resources\Factory\factory_config.json" />
    <EmbeddedResource Include="Resources\Factory\Builders\gan_builder.py" />
    <EmbeddedResource Include="Resources\Factory\Builders\mlp_builder.py" />
    <EmbeddedResource Include="Resources\Factory\model_factory.py" />
    <EmbeddedResource Include="Resources\Factory\onnx_export.py" />
    <EmbeddedResource Include="Resources\Factory\run_builder.py" />
    <EmbeddedResource Include="Resources\Factory\Builders\rnn_builder.py" />
    <EmbeddedResource Include="Resources\Factory\Builders\transformer_builder.py" />
    <EmbeddedResource Include="Resources\Factory\__init__.py" />
    <EmbeddedResource Include="Resources\Runtime\package_list.json" />
    <EmbeddedResource Include="Resources\Runtime\python_runtime.json" />
    <EmbeddedResource Include="Resources\Runtime\__init__.py" />
  </ItemGroup>

</Project>
